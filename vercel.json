{
  "framework": null,
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": { "includeFiles": "admin/**" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/admin", "destination": "/api" },
    { "source": "/admin/:path*", "destination": "/api" },
    { "source": "/images/products/:name", "destination": "/api" },
    { "source": "/sitemap.xml", "destination": "/api" },
    { "source": "/robots.txt", "destination": "/api" },
    { "source": "/:slug([a-z0-9-]+-p[0-9]+)", "destination": "/api" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" } ] },
    { "source": "/images/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" } ] }
  ],
  "crons": [
    { "path": "/api/keepalive", "schedule": "0 3 * * *" }
  ]
}
